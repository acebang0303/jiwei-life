# ==========================================
# 吉味生活 · JiweiLife 环境变量示例
# 复制为 .env 并填入真实值后，通过 IDE / 启动脚本注入
# 切勿把真实密钥提交到 git
# ==========================================

# ---- MySQL（本地 docker，端口 3307）----
JIWEI_MYSQL_HOST=localhost
JIWEI_MYSQL_PORT=3307
JIWEI_MYSQL_USERNAME=root
JIWEI_MYSQL_PASSWORD=root123

# NL2SQL 专用只读账号（仅 SELECT；见 db/08_ai_readonly_user.sql）
# 留空则 jiwei-ai 回退到上面的通用账号，仅限本地开发
JIWEI_MYSQL_RO_USERNAME=
JIWEI_MYSQL_RO_PASSWORD=

# ---- Redis / MongoDB ----
JIWEI_REDIS_HOST=localhost
JIWEI_REDIS_PORT=6380
JIWEI_REDIS_PASSWORD=
JIWEI_REDIS_DATABASE=0
JIWEI_MONGODB_HOST=localhost

# ---- PostgreSQL + pgvector ----
JIWEI_PGVECTOR_HOST=localhost
JIWEI_PGVECTOR_PORT=5433
JIWEI_PGVECTOR_PASSWORD=postgres

# ---- RocketMQ ----
JIWEI_ROCKETMQ_NAME_SERVER=localhost:9876

# ---- JWT（生产必须替换为强随机 Base64 密钥）----
JWT_ADMIN_SECRET=
JWT_USER_SECRET=

# ---- AI（DeepSeek chat + 硅基流动 embedding）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
AI_SERVICE_URL=http://localhost:8087

# ---- 微信 / 阿里云 OSS / 百度地图 / 天气（按需配置）----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCHID=
WECHAT_API_KEY=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
BAIDU_AK=
WEATHER_API_KEY=
